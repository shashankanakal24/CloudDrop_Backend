# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ==============================================================================
# CORS & FRONTEND CONFIGURATION
# ==============================================================================
# Primary frontend URL (used for links, redirects, and primary client origin)
FRONTEND_URL=http://localhost:5173

# Strict comma-separated list of allowed origins for CORS (exact URLs only, no wildcards)
# Examples:
#   Local Development: http://localhost:5173,http://localhost:3000,http://localhost:5000
#   AWS Production: https://main.d31ugm1njo9iim.amplifyapp.com,http://localhost:5173
ALLOWED_ORIGINS=https://main.d31ugm1njo9iim.amplifyapp.com,http://localhost:5173,http://localhost:3000,http://localhost:5000

# ==============================================================================
# AWS CONFIGURATION
# ==============================================================================
AWS_REGION=us-east-1
S3_BUCKET_NAME=clouddrop-storage-demo
DYNAMODB_TABLE_NAME=CloudDropFiles

# AWS Credentials (Optional for local development)
# On EC2 with IAM Instance Profile, LEAVE EMPTY! The AWS SDK retrieves credentials automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
